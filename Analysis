summary(total)





# weights -----------------------------------------------------------------

# Survey Design -----------------------------------------------------------
library(survey)
des <- svydesign(id=~hhid, strata=~fipsst + stratum, weights=~fwc, data=total, nest=TRUE)



index_ave <- svyglm(anx_cur ~ ace_cat * sport * sex,
                    design = des,
                    family = binomial())







# logistic regression model -----------------------------------------------



# Fit logistic regression model with three-way interaction
#anxiety model
anx_model <- glm(anx_cur ~ ace_cat * sport * sex + age + race, data = total, family = binomial)
summary(anx_model)

#depression model
depr_model <- glm(depr_cur ~ ace_cat * sport * sex + age + race, data = total, family = binomial)
summary(depr_model)




